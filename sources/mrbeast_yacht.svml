<?svml using="@hypit/markup@1"?>
<svml>
  <import as="audio" from="@hypit/audio-track@1"/>
  <import as="visual" from="@hypit/visual-track@1"/>
  <import from="@hypit/script@1"/>
  <import as="text" from="@hypit/text@1"/>
  <import as="mediaop" from="@hypit/media-operations@1"/>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="fonts" from="@hypit/fontsource@1"/>
  <import as="typo" from="@hypit/text-fine@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="html" from="@hypit/html-video@1"/>
  <import as="look" source="./look.svs"/>

  <script id="story">
    <opening><HOST>WHAT IF YOU TRIED TO BUY A $1 YACHT AGAINST A $1 BILLION SUPERYACHT?</HOST></opening>
    <setup><HOST>MRBEAST BOUGHT A SINGLE DOLLAR WORTH OF CARDBOARD AND TESTED IT AGAINST A LUXURY YACHT.</HOST></setup>
    <build><HOST>HE BUILT A TINY HULL, ADDED A MAKESHIFT MOTOR, AND LAUNCHED IT INTO OPEN WATER.</HOST></build>
    <payoff><HOST>AS SOON AS THE $1 BOAT HIT THE WATER, IT STARTED TO SINK IMMEDIATELY!</HOST></payoff>
  </script>

  <space:Canvas id="canvas" width="1080" height="1920"/>
  <time:Clock id="clock" frame-rate="30"/>

  <space:Frame id="viewport" within={canvas.bounds}
    left="0%" top="0%" right="100%" bottom="100%"/>
  <space:Frame id="subtitle-frame" within={canvas.bounds}
    left="5%" top="55%" right="95%" bottom="85%"/>

  <time:Timeline id="timeline" clock={clock} end="20.0s">
    <time:Window id="hook" from="0.0s" for="4.0s"/>
    <time:Window id="setup" from="4.0s" for="6.0s"/>
    <time:Window id="build" from="10.0s" for="6.0s"/>
    <time:Window id="payoff" from="16.0s" for="4.0s"/>
  </time:Timeline>

  <visual:Track id="main-video" timeline={timeline.timeline}>
    <visual:Clip id="mrbeast-footage" source="mrbeast_raw" during={timeline.window}
      frame={viewport} fit="cover" z="10"/>
  </visual:Track>

  <audio:Track id="main-audio" timeline={timeline.timeline}>
    <audio:Clip id="creator-sound" source="mrbeast_raw" during={timeline.window} volume="1.0"/>
  </audio:Track>

  <fonts:Face id="primary-font" package="@fontsource/montserrat" weight="800" style="normal"/>

  <typo:Style id="caption-style" recipe={look.text.caption.highlight} font={primary-font}>
    <typo:Fill color="#FFE600"/>
    <typo:Stroke color="#000000" width="5.8"/>
  </typo:Style>

  <film:Film id="main" canvas={canvas.canvas} timeline={timeline.timeline} appearance={look.film.main}>
    <film:Track source={main-video.visual}/>
    <film:Track source={main-audio.audio}/>
  </film:Film>

  <html:Video id="final" composition={main.composition} timeline={timeline.timeline}/>
</svml>
